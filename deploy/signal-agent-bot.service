[Unit]
Description=signal-agent Q&A bot (Slack Socket Mode, answers from the news archive)
After=network-online.target
Wants=network-online.target
# A crash loop (bad env, Slack unreachable at boot) stops after 5 tries in 10
# minutes instead of restarting forever; `systemctl status` then shows failed.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=signal
Group=signal
WorkingDirectory=/opt/signal-agent/repo
EnvironmentFile=/opt/signal-agent/shared/agent.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/signal-agent/repo/.venv/bin/python src/bot.py
# Exits 0 when SLACK_APP_TOKEN isn't set, so an unconfigured box doesn't loop.
Restart=on-failure
RestartSec=10
Nice=5

[Install]
WantedBy=multi-user.target
