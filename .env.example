# Copy this file to .env and fill in real values. .env is gitignored.
# In the AWS deployment these are provided from Secrets Manager
# (signal-agent/prod/agent-env) via systemd EnvironmentFile — see infra/README.md.

# --- LLM providers ---
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
# Optional: routes the single ranking call to Claude; falls back to Perplexity if unset.
ANTHROPIC_API_KEY=

# --- Slack delivery ---
SLACK_WEBHOOK_URL=
SLACK_CHANNEL_LABEL=
# Optional: bot-token path (posts via chat.postMessage instead of the webhook).
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# --- Sector digest (bi-weekly per-portco roundups; `--mode sector`) ---
# All 7 sector messages post to ONE channel. Provide EITHER a bot-token target
# (SLACK_BOT_TOKEN above + SLACK_CHANNEL_ID_SECTOR) OR a dedicated webhook
# (SLACK_WEBHOOK_URL_SECTOR). Either falls back to the shared values above.
SLACK_CHANNEL_ID_SECTOR=
SLACK_CHANNEL_LABEL_SECTOR=
SLACK_WEBHOOK_URL_SECTOR=
